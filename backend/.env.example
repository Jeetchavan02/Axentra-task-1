# Copy to .env and adjust. Never commit .env.
PROJECT_NAME="Subscription Tracker"
API_VERSION="0.1.0"
ALLOWED_ORIGINS=["http://localhost:5173"]

# Local development database (see docker-compose.yml). Choose your own password in .env.
DB_USER=axentra
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5433
DB_NAME=subscription_tracker

# Required. Left empty on purpose, so the app refuses to start until you set your own:
#   openssl rand -hex 32
JWT_SECRET=
